# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Neon PostgreSQL Database
# Get your connection string from: https://console.neon.tech
DATABASE_URL=postgresql://username:password@ep-xxx-region.aws.neon.tech/sneaker_drop?sslmode=require

# Reservation Configuration
RESERVATION_DURATION_SECONDS=60

# Stock Recovery Check Interval (milliseconds)
STOCK_RECOVERY_INTERVAL_MS=5000
